{
  "extends": "./tsconfig.base.json",
  "include": [
    "tests/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "electron.vite.config.ts",
    "src/shared/**/*",
    "src/renderer/src/lib/nova/machine.ts",
    "src/renderer/src/lib/nova/face-driver.ts",
    "src/renderer/src/lib/nova/mouth-track.ts",
    "src/renderer/src/lib/nova/audio/barge-in.ts",
    "src/main/agents/**/*",
    "src/main/attachments/**/*",
    "src/main/bridge/**/*",
    "src/main/db/**/*",
    "src/main/git/**/*",
    "src/main/groups/**/*",
    "src/main/knowledge/**/*",
    "src/main/models/**/*",
    "src/main/personal/**/*",
    "src/main/plugins/**/*",
    "src/main/policy/**/*",
    "src/main/providers/**/*",
    "src/main/protocol/attachment-request.ts",
    "src/main/protocol/knowledge-request.ts",
    "src/main/protocol/schemes.ts",
    "src/main/protocol/voice-model-request.ts",
    "src/main/review/**/*",
    "src/main/sessions/**/*",
    "src/main/surface/**/*",
    "src/main/usage/**/*",
    "src/main/voice/**/*",
    "src/main/util/**/*",
    "src/main/ipc/**/*",
    "src/main/logging.ts",
    "src/main/app/app-services.ts",
    "src/main/app/close-gate.ts",
    "src/main/app/csp.ts",
    "src/main/app/late-ref.ts",
    "src/main/app/main-window.ts",
    "src/main/app/provider-checks.ts",
    "src/main/app/lockdown.ts",
    "src/main/app/permissions.ts",
    "src/main/app/app-menu.ts",
    "src/main/app/preview-window.ts",
    "src/main/app/smoke.ts",
    "src/main/app/window-options.ts",
    "src/main/platform/dialogs.ts",
    "src/main/platform/shell-service.ts"
  ],
  "exclude": ["tests/renderer"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  }
}

# W5: commits a README.md edit and stays working, so the file has a worker still on it.
{"waitForStdin": "*"}
{"init": true, "model": "claude-sonnet-5-5", "mcp": true}
{"shell": "echo 'draft notes' >> README.md && git add -A && git -c user.name=Fake -c user.email=fake@example.com commit -q -m 'Draft readme'"}
{"mcp": {"tool": "report_progress", "args": {"note": "Editing the readme"}}}
{"hang": true}

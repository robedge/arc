# Autonomous brain: starts a Claude worker that uses the user's Figma MCP server. It cannot decide the changing
# tool, so it passes that request on to the user.
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"say":"Title: Figma sync\n\nStarting a worker for the Figma file."}
{"mcp":{"tool":"spawn_worker","args":{"name":"figma-sync","task":"Read the Figma file and update it","repos":["api"],"provider":"claude","model":"sonnet"}}}
{"say":"The worker is running."}
{"result":true}
{"waitForStdin":"asks permission to run"}
{"mcp":{"tool":"escalate_to_user","args":{"requestId":"{{REQUEST_ID}}","reason":"It changes the Figma file."}}}
{"say":"I passed the Figma change to you."}
{"result":true}
{"waitForStdin":"finished"}
{"say":"The worker finished."}
{"result":true}

# Makes one commit that is not in the session branch, then stays alive until it is stopped.
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"shell":"echo change > c.txt && git add c.txt && git -c user.name=Fake -c user.email=fake@example.com commit -q -m 'Add c.txt'"}
{"mcp":{"tool":"report_progress","args":{"note":"Committed c.txt"}}}
{"hang":true}

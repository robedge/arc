# Autonomous brain: two workers change the same line of README.md. After both finish it merges W1, then W2
# (which conflicts; Arc starts a resolver and the call returns once the resolver has committed).
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"say":"Title: Two edits of one file\n\nStarting two workers."}
{"mcp":{"tool":"spawn_worker","args":{"name":"api-retry","task":"Note the retry","repos":["api"]}}}
{"mcp":{"tool":"spawn_worker","args":{"name":"api-timeout","task":"Note the timeout","repos":["api"]}}}
{"say":"Both workers are running."}
{"result":true}
{"waitForStdin":"finished"}
{"waitForStdin":"finished"}
{"mcp":{"tool":"merge_worker","args":{"workerId":"W1"}}}
{"mcp":{"tool":"merge_worker","args":{"workerId":"W2"}}}
{"say":"Both merged."}
{"result":true}
{"waitForStdin":"All workers finished"}
{"say":"Summary: README.md has both notes."}
{"result":true}

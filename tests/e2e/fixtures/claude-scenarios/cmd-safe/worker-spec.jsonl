# Command worker: edits and commits a file (the fake plays the hooks the CLI would load), then asks to push.
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"shell":"mkdir -p specs && printf \"# Retry settings\\n\" > specs/retry-settings.md && git add specs && git -c user.name=Fake -c user.email=fake@example.com commit -q -m \"Add retry settings spec\""}
{"tool":{"name":"Bash","input":{"command":"git push origin arc/retry-settings","description":"Push the session branch"}}}
{"mcp":{"tool":"report_done","args":{"summary":"Wrote the spec"}}}
{"say":"Done."}
{"result":true}

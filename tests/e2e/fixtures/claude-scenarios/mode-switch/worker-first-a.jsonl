# A long-running worker: still Working when the user switches mode, then reports done.
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"mcp":{"tool":"report_progress","args":{"note":"Working"}}}
{"delay":14000}
{"mcp":{"tool":"report_done","args":{"summary":"Finished first A"}}}
{"say":"Done."}
{"result":true}

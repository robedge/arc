# A Claude worker that commits a new file and reports done.
{"waitForStdin":"*"}
{"init":true,"model":"claude-sonnet-5-5","mcp":true}
{"mcp":{"tool":"report_progress","args":{"note":"Patching"}}}
{"shell":"echo claude > claude.txt && git add claude.txt && git -c user.name=Fake -c user.email=fake@example.com commit -q -m 'Claude patch'"}
{"mcp":{"tool":"report_done","args":{"summary":"Patched with Claude"}}}
{"say":"Done."}
{"result":true}
